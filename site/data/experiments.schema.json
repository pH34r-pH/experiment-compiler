{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiments.tyharbin.com/data/experiments.schema.json",
  "title": "Experiment Compiler public catalog projection",
  "type": "object",
  "required": ["schemaVersion", "project", "experiments"],
  "additionalProperties": false,
  "$defs": {
    "packageIdentity": {
      "type": "object",
      "required": ["sha256", "size"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "resourceMeasurement": {
      "type": "object",
      "required": ["propertyID", "value", "unitText", "measurementTechnique", "evidence"],
      "properties": {
        "propertyID": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string"] },
        "unitText": { "type": ["string", "null"] },
        "measurementTechnique": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["string", "object", "null"] }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": {
      "type": "object",
      "required": ["name", "repository"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "Experiment Compiler" },
        "repository": { "const": "https://github.com/pH34r-pH/experiment-compiler" }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "profile", "source", "package", "detailUrl", "backlinks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
          "title": { "type": "string", "minLength": 1 },
          "profile": { "enum": ["compiled-experiment-v1", "compiled-experiment-lifecycle-v1"] },
          "source": {
            "type": "object",
            "required": ["repository", "commit"],
            "properties": {
              "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "package": { "$ref": "#/$defs/packageIdentity" },
          "experimentIdentifier": { "type": "string", "minLength": 1 },
          "lineage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relation", "reference"],
              "properties": {
                "relation": {
                  "enum": ["https://www.w3.org/ns/prov#wasRevisionOf", "https://www.w3.org/ns/prov#wasDerivedFrom"]
                },
                "reference": { "type": "string", "minLength": 1 },
                "package": { "$ref": "#/$defs/packageIdentity" }
              },
              "additionalProperties": false
            }
          },
          "lifecycle": {
            "type": "object",
            "required": ["creativeWorkStatus", "attemptCount", "processRunCrate", "potentialActionCount", "resourceMeasurements"],
            "properties": {
              "creativeWorkStatus": { "type": ["string", "object"] },
              "attemptCount": { "type": "integer", "minimum": 0 },
              "processRunCrate": { "type": "boolean" },
              "potentialActionCount": { "type": "integer", "minimum": 0 },
              "resourceMeasurements": {
                "type": "array",
                "items": { "$ref": "#/$defs/resourceMeasurement" }
              }
            }
          },
          "protocol": {
            "type": "object",
            "required": ["record", "text"],
            "additionalProperties": false,
            "properties": {
              "record": { "type": "string", "minLength": 1 },
              "text": { "type": "string" }
            }
          },
          "executionAttempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "actionStatus",
                "result"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "actionStatus": {
                  "enum": [
                    "https://schema.org/ActiveActionStatus",
                    "https://schema.org/CompletedActionStatus",
                    "https://schema.org/FailedActionStatus"
                  ]
                },
                "result": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "scientificInterpretation": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["record", "summary", "aboutAttempt"],
              "properties": {
                "record": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 },
                "aboutAttempt": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "detailUrl": { "type": "string", "pattern": "^/experiments/[a-z0-9-]+/$" },
          "backlinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "sourceCommit"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https://tyharbin\\.com/articles/[a-z0-9-]+/$" },
                "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          },
          "isPartOf": {
            "type": "object",
            "required": ["@id", "@type", "name"],
            "additionalProperties": false,
            "properties": {
              "@id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^https://experiments\\.tyharbin\\.com/#family-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "@type": { "const": "CreativeWork" },
              "name": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          "archivalRelease": {
            "type": "object",
            "required": ["repository", "releaseTag", "releaseUrl"],
            "additionalProperties": false,
            "properties": {
              "repository": { "const": "pH34r-pH/compiled-experiments" },
              "releaseTag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/pH34r-pH/compiled-experiments/releases/tag/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" },
              "zenodoRecordUrl": { "type": "string", "pattern": "^https://zenodo\\.org/records/[1-9][0-9]*$" }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
